# Copy to .env and fill in. Used by docker-compose.
# Supabase and Paystack are external services -- there is nothing to run locally.

# Supabase -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack -> Settings -> API Keys & Webhooks (test keys for local work)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx

# Browser-facing API origin
NEXT_PUBLIC_API_URL=http://localhost:4000

# Where Paystack sends the buyer back after checkout
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

CURRENCY=NGN
